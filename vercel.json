{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": "dist-com",
  "cleanUrls": true,
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "codex/english-com": true
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.petrovichbrothers.com"
        }
      ],
      "destination": "https://petrovichbrothers.com/:path*",
      "permanent": true
    },
    {
      "source": "/video-content/",
      "destination": "/works/exhibitions/",
      "permanent": true
    },
    {
      "source": "/videocontent/",
      "destination": "/works/exhibitions/",
      "permanent": true
    },
    {
      "source": "/projects/",
      "destination": "/works/",
      "permanent": true
    },
    {
      "source": "/blogs/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/testimonials/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contacts/",
      "destination": "/#contact",
      "permanent": true
